# Copia este archivo a ".env" y ajusta la cadena de conexion con tu
# usuario y contrasenya reales de PostgreSQL.
# El ".env" real esta en .gitignore, no se sube.

# --- PostgreSQL ---
# Instalacion local por winget (PostgreSQL.PostgreSQL.17):
#   - host localhost, puerto 5432
#   - superusuario "postgres" con la contrasenya que pusiste en el instalador
#   - hay que crear la base de datos "scouting" una vez:
#       "C:\Program Files\PostgreSQL\17\bin\createdb.exe" -U postgres scouting
DATABASE_URL=postgresql+psycopg2://TU_USUARIO:TU_PASSWORD@localhost:5432/scouting

# Ruta a los datos ya validados del experimento de Fase 0 (para el smoke test).
# Relativa a la raiz de scouting-engine/ o absoluta.
DATA_EXPERIMENT_DIR=../data-experiment
